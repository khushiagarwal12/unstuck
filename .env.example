# Copy to backend/.env for local development. Never commit the real file.

# --- AI (Google AI Studio). Confirm model ids and rate limits on Day 0. ---
LLM_BACKEND=aistudio
GEMINI_API_KEY=
GEMINI_MODEL_MAIN=gemini-3-flash-preview
GEMINI_MODEL_FAST=gemini-3.1-flash-lite-preview
GEMINI_EMBED_MODEL=
LLM_RPM_MAIN=5
LLM_RPM_FAST=10

# --- Auth ---
# firebase (default) verifies real Firebase ID tokens. dev accepts "Bearer dev-<uid>"; local use only.
AUTH_MODE=firebase
# The whole service-account JSON on one line. Host secret only.
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- CORS (JSON list) ---
CORS_ORIGINS=["http://localhost:5173"]

# --- Abuse protection ---
DAILY_UPLOADS_PER_USER=3
DAILY_LLM_CALLS_PER_USER=120
JUDGE_CODE=
