# Copy to backend/.env for local development. Never commit the real file.
# On Render, set each of these as an environment variable instead.

# --- AI (Google AI Studio). Confirm model ids and rate limits on Day 0. ---
LLM_BACKEND=aistudio
GEMINI_API_KEY=
GEMINI_MODEL_MAIN=gemini-3-flash-preview
GEMINI_MODEL_FAST=gemini-3.1-flash-lite-preview
GEMINI_EMBED_MODEL=
LLM_RPM_MAIN=5
LLM_RPM_FAST=10

# --- Firebase Admin: the whole service-account JSON on one line. Host secret only. ---
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- CORS (JSON list): the origins your frontend is served from ---
CORS_ORIGINS=["http://localhost:5173"]

# --- Abuse protection (ARCHITECTURE.md section 10) ---
DAILY_UPLOADS_PER_USER=3
DAILY_LLM_CALLS_PER_USER=120
DAILY_LLM_CALLS_GLOBAL=800
JUDGE_CODE=
JUDGE_CAP_MULTIPLIER=5

# --- Day 1 end-to-end check. Spends a little quota; keep false on a public host. ---
ENABLE_DIAGNOSTICS=false
