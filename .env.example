# Firebase Web app configuration (public; these VITE_ values are bundled into the browser).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Firebase Admin, Firestore and Vertex AI use Application Default Credentials.
FIREBASE_PROJECT_ID=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL_MAIN=gemini-2.5-flash
GEMINI_MODEL_FAST=gemini-2.5-flash-lite

# Keep every still-valid key during rotation. Use random values >=32 characters.
ANSWER_SIGNING_ACTIVE_KEY_ID=current
ANSWER_SIGNING_KEYS_JSON=

# Optional APIs: either a restricted API key or ADC can be used for Text-to-Speech and Translation.
# YouTube Data API currently requires an API key.
GOOGLE_API_KEY=

# Local development only: short-lived output of `gcloud auth application-default print-access-token`.
# Never configure a static access token in a deployed environment.
# GOOGLE_ACCESS_TOKEN=
