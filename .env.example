# Server secrets. Set these as project secrets (Lovable) or Cloud Run env vars. Never commit real values.

# --- Gemini (pick one) ---
GEMINI_API_KEY=                 # Google AI Studio key
# LLM_BACKEND=vertex            # use Vertex AI instead (bills your Google Cloud project / trial credits)
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL_MAIN=gemini-2.5-flash
GEMINI_MODEL_FAST=gemini-2.5-flash-lite

# --- Other Google APIs (each feature appears only when its credentials work) ---
GOOGLE_API_KEY=                 # Cloud API key with Text-to-Speech, Translation and YouTube Data API v3 enabled
# GOOGLE_SERVICE_ACCOUNT_JSON=  # alternative for Vertex AI / Text-to-Speech / Translation (one line)
# GOOGLE_ACCESS_TOKEN=          # local dev only: gcloud auth print-access-token
