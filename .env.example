# ============================================================================
# IMPORTANT: Copy this file to .env and fill in the values below.
# The .env file is git-ignored for security.
# ============================================================================
#
# Firebase Web app configuration (public; these VITE_ values are bundled into the browser).
# Get these from Firebase Console → Project Settings → General → Your apps → Web app
# WARNING: Google sign-in will NOT work until all four VITE_FIREBASE_* variables are set.
VITE_FIREBASE_API_KEY=AIzaSyAnMjKJHwxFtDxk84OS5z-qHROeexikH9I
VITE_FIREBASE_AUTH_DOMAIN=unstuck-e6012.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=unstuck-e6012
VITE_FIREBASE_APP_ID=1:783684471532:web:10f2abcd80d95d90e873c9

# Firebase Admin, Firestore and Vertex AI use Application Default Credentials.
FIREBASE_PROJECT_ID=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL_MAIN=gemini-2.5-flash
GEMINI_MODEL_FAST=gemini-2.5-flash-lite

# Keep every still-valid key during rotation. Use random values >=32 characters.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
ANSWER_SIGNING_ACTIVE_KEY_ID=current
ANSWER_SIGNING_KEYS_JSON=

# Optional APIs: either a restricted API key or ADC can be used for Text-to-Speech and Translation.
# YouTube Data API currently requires an API key.
GOOGLE_API_KEY=

# Local development only: short-lived output of `gcloud auth application-default print-access-token`.
# Never configure a static access token in a deployed environment.
# GOOGLE_ACCESS_TOKEN=

# Guest rate limiting reads the client IP from X-Forwarded-For, counted from the END (the proxy-appended entry).
# Cloud Run directly: 1 (default). Add one per extra proxy/load balancer in front of the service.
TRUSTED_PROXY_HOPS=1
# Only set to true if the service really is behind Cloudflare; otherwise CF-Connecting-IP is spoofable.
# TRUST_CF_CONNECTING_IP=true
