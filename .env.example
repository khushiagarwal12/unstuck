# Copy to backend/.env for local development. Never commit the real file.

# --- AI (Google AI Studio). Confirmed live on Day 0. ---
LLM_BACKEND=aistudio
GEMINI_API_KEY=
GEMINI_MODEL_MAIN=gemini-3.5-flash-lite
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
LLM_RPM_MAIN=10
LLM_RPM_FAST=15

# --- Auth ---
# firebase (default) verifies real Firebase ID tokens. dev accepts "Bearer dev-<uid>"; local use only.
AUTH_MODE=dev
# The whole service-account JSON on one line. Host secret only.
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- CORS (JSON list) ---
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# --- Abuse protection ---
DAILY_UPLOADS_PER_USER=5
DAILY_LLM_CALLS_PER_USER=150
JUDGE_CODE=
